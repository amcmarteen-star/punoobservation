# Copy this file to .env and fill in the values. .env is never committed.

SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=postgresql://user:password@localhost:5432/punoobservation

# --- Email (optional on your own computer, required on the live site) ----
# Leave MAIL_SERVER out and no email is sent: each one is written to the
# server log instead, so you can read it while developing.
#
# The live site uses Brevo. Every value comes from Brevo's
# Settings > SMTP & API page:
#   MAIL_USERNAME  the "SMTP login" shown there. On newer accounts it looks
#                  like 123456@smtp-brevo.com, not your account email.
#   MAIL_PASSWORD  an SMTP key made under "SMTP Keys". Not an API key:
#                  Brevo keeps the two apart, and an API key here fails.
# MAIL_FROM must use a sender or domain verified in Brevo (Senders,
# Domains & Dedicated IPs). Authenticate punoobservation.app there and add
# the DNS records it lists, or emails are refused or land in spam.
#
# MAIL_SERVER=smtp-relay.brevo.com
# MAIL_PORT=587
# MAIL_SECURITY=starttls
# MAIL_USERNAME=123456@smtp-brevo.com
# MAIL_PASSWORD=xsmtpsib-your-smtp-key
# MAIL_FROM=PuNoObservation <noreply@punoobservation.app>
#
# The site's public address, for links in emails. Required on the live site.
# APP_BASE_URL=https://punoobservation.app

# --- Map tiles (optional) ------------------------------------------------
# Leave these out to use the defaults in app/config.py: the public
# OpenStreetMap and Esri servers. Those are fine for development and
# demonstrations only.
#
# Before a CENRO or DENR office uses the system every day, point these at
# a source the office is licensed to use:
#   - Street map: the OSM Tile Usage Policy asks heavy users to use a
#     commercial tile provider or host their own tiles.
#   - Satellite: Esri expects production apps to use an ArcGIS account
#     and key. ArcGIS Location Platform has a free monthly tile quota.
#
# {s} {z} {x} {y} are filled in by the map. A key goes in the URL.

# MAP_STREET_TILES=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
# MAP_STREET_ATTRIBUTION=&copy; OpenStreetMap contributors

# Esri with an ArcGIS key:
# MAP_SATELLITE_TILES=https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}?token=YOUR_ARCGIS_KEY
# MAP_SATELLITE_ATTRIBUTION=Imagery &copy; Esri, Maxar, Earthstar Geographics
# MAP_SATELLITE_MAX_ZOOM=18

# To turn the satellite view off, set it to nothing:
# MAP_SATELLITE_TILES=
